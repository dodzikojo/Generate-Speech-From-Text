<UserControl
    x:Class="IssueLab.VoiceBench.App.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IssueLab.VoiceBench.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="800">

    <Grid Background="{ThemeResource BaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ProjectsRoot" Margin="16,20,16,36" MaxWidth="1240" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ProjectsHeader">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROJECTS  /  LOCAL FOLDERS" Style="{StaticResource UtilityLabelTextStyle}" />
                        <TextBlock Text="Your narration rooms" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Scripts stay in their folders. VoiceBench keeps takes, approvals, and exports beside them."
                                   Style="{StaticResource ReadingTextStyle}" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ProjectHeaderActions" Grid.Row="1" Grid.Column="0"
                                Margin="0,16,0,0" Orientation="Vertical" Spacing="8"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource QuietButtonStyle}"
                                Click="OpenFolder_Click"
                                ToolTipService.ToolTip="Open an existing project folder (Ctrl+O)"
                                AutomationProperties.Name="Open an existing project folder"
                                AutomationProperties.AcceleratorKey="Control+O">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Style="{StaticResource SignalButtonStyle}"
                                Click="NewProject_Click"
                                ToolTipService.ToolTip="Create a new project (Ctrl+N)"
                                AutomationProperties.Name="Create a new VoiceBench project"
                                AutomationProperties.AcceleratorKey="Control+N">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="New project" />
                            </StackPanel>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ProjectStatusBar" Grid.Row="1" Margin="0,20,0,0"
                         IsOpen="False" IsClosable="True" Severity="Informational"
                         Title="Project action" />

                <Grid x:Name="ProjectCards" Grid.Row="2" Margin="0,20,0,0" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="RecentProjectsToolbar" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="RECENT PROJECTS" Style="{StaticResource UtilityLabelTextStyle}" />
                            <TextBlock x:Name="RecentProjectCountText" Text="0 SAVED" Style="{StaticResource StudioHeadingTextStyle}" />
                        </StackPanel>
                        <AutoSuggestBox x:Name="ProjectFilterBox" Grid.Column="1" Width="300" VerticalAlignment="Center"
                                        PlaceholderText="Filter by name or folder" QueryIcon="Find"
                                        TextChanged="ProjectFilterBox_TextChanged"
                                        AutomationProperties.Name="Filter recent projects" />
                    </Grid>

                    <TextBlock x:Name="RecentProjectsEmptyText" Grid.Row="1"
                               Text="Projects you create or open will stay here after VoiceBench restarts."
                               Style="{StaticResource ReadingTextStyle}"
                               Foreground="{ThemeResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="RecentProjectsList" Grid.Row="1"
                                   ItemsSource="{x:Bind VisibleProjects, Mode=OneWay}"
                                   AutomationProperties.Name="Recent VoiceBench projects">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="360" MinItemHeight="168" MinColumnSpacing="14" MinRowSpacing="14"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentProjectListItem">
                                <Border Style="{StaticResource StudioCardStyle}" Padding="16,14"
                                        BorderBrush="{x:Bind CardBorderBrush}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ActionText}" Tag="{x:Bind ProjectRoot}" IsEnabled="{x:Bind IsAvailable}" Click="RecentProject_Click" />
                                            <MenuFlyoutItem Text="Show in folder" Tag="{x:Bind ProjectRoot}" IsEnabled="{x:Bind IsAvailable}" Click="ShowProjectInFolder_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy folder path" Tag="{x:Bind ProjectRoot}" Click="CopyProjectPath_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Remove from list" Tag="{x:Bind ProjectRoot}" Click="RemoveRecentProject_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid RowSpacing="6" ColumnSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource StudioHeadingTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" BorderBrush="{x:Bind StatusBrush}">
                                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="10" FontFamily="{StaticResource UtilityFont}" Foreground="{x:Bind StatusBrush}" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ProjectRoot}" Style="{StaticResource UtilityLabelTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTipService.ToolTip="{x:Bind ProjectRoot}" />
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind DetailLine}" Style="{StaticResource ReadingTextStyle}"
                                                   FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="3" />
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                                            <Button Content="{x:Bind ActionText}"
                                                    Tag="{x:Bind ProjectRoot}"
                                                    IsEnabled="{x:Bind IsAvailable}"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Click="RecentProject_Click"
                                                    AutomationProperties.Name="{x:Bind AutomationName}" />
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind ProjectRoot}" IsEnabled="{x:Bind IsAvailable}"
                                                    Click="ShowProjectInFolder_Click"
                                                    ToolTipService.ToolTip="Show in File Explorer"
                                                    AutomationProperties.Name="{x:Bind ShowInFolderAutomationName}">
                                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind ProjectRoot}"
                                                    Click="RemoveRecentProject_Click"
                                                    ToolTipService.ToolTip="Remove from this list (the folder is not deleted)"
                                                    AutomationProperties.Name="{x:Bind RemoveAutomationName}">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border x:Name="EmptyProjectCard" Grid.Row="2" Visibility="Collapsed"
                            Style="{StaticResource StudioPanelStyle}" Padding="32">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="360" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource ActiveSignalBrush}" />
                            <TextBlock Text="Bring in a script" Style="{StaticResource StudioHeadingTextStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Create a project, then import Markdown or text. Headings and --- markers become separate takes."
                                       Style="{StaticResource ReadingTextStyle}"
                                       Foreground="{ThemeResource MutedTextBrush}"
                                       TextAlignment="Center" />
                            <Button Content="Create the first project" Style="{StaticResource SignalButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Click="NewProject_Click"
                                    AutomationProperties.Name="Create the first VoiceBench project" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" Margin="0,24,0,0"
                           Text="VoiceBench stores relative paths only. You can move or archive the whole project folder. Removing a project from this list never deletes its folder."
                           Style="{StaticResource UtilityLabelTextStyle}" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <ContentDialog x:Name="NewProjectDialog"
                       Title="Create a narration project"
                       PrimaryButtonText="Create project"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="NewProjectDialog_PrimaryButtonClick">
            <StackPanel Spacing="12">
                <TextBlock Text="VoiceBench creates a movable folder with scripts, takes, masters, and reports."
                           Style="{StaticResource ReadingTextStyle}" />
                <TextBox x:Name="ProjectNameBox" Header="Project name" PlaceholderText="Training video narration" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectFolderBox" Header="Parent folder" PlaceholderText="Choose where to save the project" />
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="BrowseProjectFolder_Click"
                            AutomationProperties.Name="Browse for the parent project folder" />
                </Grid>
                <ComboBox Header="Audio standard" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Mono · 48 kHz · −16 LUFS · −1 dBTP" />
                </ComboBox>
                <TextBlock Text="No provider key is needed until you render or audition a voice."
                           Style="{StaticResource UtilityLabelTextStyle}" />
            </StackPanel>
        </ContentDialog>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ProjectsWidthStates">
                <VisualState x:Name="NarrowProjects" />
                <VisualState x:Name="MediumProjects">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProjectHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="ProjectHeaderActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideProjects">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProjectsRoot.Margin" Value="32,28,32,48" />
                        <Setter Target="ProjectHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="ProjectHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="ProjectHeaderActions.Margin" Value="16,0,0,0" />
                        <Setter Target="ProjectHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="ProjectHeaderActions.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
