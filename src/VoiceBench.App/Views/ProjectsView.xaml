<UserControl
    x:Class="IssueLab.VoiceBench.App.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IssueLab.VoiceBench.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="800">

    <Grid Background="{ThemeResource BaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ProjectsRoot" Margin="16,20,16,36" MaxWidth="1180" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ProjectsHeader">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROJECTS  /  LOCAL FOLDERS" Style="{StaticResource UtilityLabelTextStyle}" />
                        <TextBlock Text="Your narration rooms" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Scripts stay in their folders. VoiceBench keeps takes, approvals, and exports beside them."
                                   Style="{StaticResource ReadingTextStyle}" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ProjectHeaderActions" Grid.Row="1" Grid.Column="0"
                                Margin="0,16,0,0" Orientation="Vertical" Spacing="8"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                        <Button Content="Open folder" Style="{StaticResource QuietButtonStyle}"
                                Click="OpenFolder_Click"
                                AutomationProperties.Name="Open an existing project folder"
                                AutomationProperties.AcceleratorKey="Control+O">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Content="New project" Style="{StaticResource SignalButtonStyle}"
                                Click="NewProject_Click"
                                AutomationProperties.Name="Create a new VoiceBench project"
                                AutomationProperties.AcceleratorKey="Control+N">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ProjectStatusBar" Grid.Row="1" Margin="0,20,0,0"
                         IsOpen="False" IsClosable="True" Severity="Informational"
                         Title="Project action" />

                <Grid x:Name="ProjectCards" Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RecentProjectColumn" Width="*" />
                        <ColumnDefinition x:Name="EmptyProjectColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource StudioPanelStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="RECENT PROJECTS" Style="{StaticResource UtilityLabelTextStyle}" />
                                    <TextBlock Text="Your local project shelf" Style="{StaticResource StudioHeadingTextStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="RecentProjectCountText" Grid.Column="1" Text="0 SAVED"
                                           Style="{StaticResource UtilityLabelTextStyle}"
                                           VerticalAlignment="Top" />
                            </Grid>
                            <TextBlock x:Name="RecentProjectsEmptyText"
                                       Text="Projects you create or open will stay here after VoiceBench restarts."
                                       Style="{StaticResource ReadingTextStyle}"
                                       Foreground="{ThemeResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <ItemsControl x:Name="RecentProjectsList"
                                          ItemsSource="{x:Bind RecentProjects, Mode=OneWay}"
                                          AutomationProperties.Name="Recent VoiceBench projects">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RecentProjectListItem">
                                        <Border BorderBrush="{ThemeResource DividerBrush}"
                                                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                            <Grid ColumnSpacing="16">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="RecentProjectRowStates">
                                                        <VisualState x:Name="NarrowRecentProjectRow" />
                                                        <VisualState x:Name="WideRecentProjectRow">
                                                            <VisualState.StateTriggers>
                                                                <AdaptiveTrigger MinWindowWidth="520" />
                                                            </VisualState.StateTriggers>
                                                            <VisualState.Setters>
                                                                <Setter Target="RecentActionButton.(Grid.Row)" Value="0" />
                                                                <Setter Target="RecentActionButton.(Grid.Column)" Value="1" />
                                                                <Setter Target="RecentActionButton.Margin" Value="0" />
                                                                <Setter Target="RecentActionButton.HorizontalAlignment" Value="Right" />
                                                                <Setter Target="RecentActionButton.VerticalAlignment" Value="Center" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource StudioHeadingTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ProjectRoot}" Style="{StaticResource UtilityLabelTextStyle}"
                                                               TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind DetailLine}" Style="{StaticResource ReadingTextStyle}"
                                                               Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource UtilityLabelTextStyle}" />
                                                </StackPanel>
                                                <Button x:Name="RecentActionButton" Grid.Row="1" Grid.Column="0"
                                                        Content="{x:Bind ActionText}"
                                                        Tag="{x:Bind ProjectRoot}"
                                                        IsEnabled="{x:Bind IsAvailable}"
                                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        Click="RecentProject_Click"
                                                        AutomationProperties.Name="{x:Bind AutomationName}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EmptyProjectCard" Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource StudioPanelStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="320" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource ActiveSignalBrush}" />
                            <TextBlock Text="Bring in a script" Style="{StaticResource StudioHeadingTextStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Create a project, then import Markdown or text. Headings and --- markers become separate takes."
                                       Style="{StaticResource ReadingTextStyle}"
                                       Foreground="{ThemeResource MutedTextBrush}"
                                       TextAlignment="Center" />
                            <Button Content="Create the first project" Style="{StaticResource SignalButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Click="NewProject_Click"
                                    AutomationProperties.Name="Create the first VoiceBench project" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" Margin="0,24,0,0"
                           Text="VoiceBench stores relative paths only. You can move or archive the whole project folder."
                           Style="{StaticResource UtilityLabelTextStyle}" />
            </Grid>
        </ScrollViewer>

        <ContentDialog x:Name="NewProjectDialog"
                       Title="Create a narration project"
                       PrimaryButtonText="Create project"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="NewProjectDialog_PrimaryButtonClick">
            <StackPanel Spacing="12">
                <TextBlock Text="VoiceBench creates a movable folder with scripts, takes, masters, and reports."
                           Style="{StaticResource ReadingTextStyle}" />
                <TextBox x:Name="ProjectNameBox" Header="Project name" PlaceholderText="Training video narration" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectFolderBox" Header="Parent folder" PlaceholderText="Choose where to save the project" />
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="BrowseProjectFolder_Click"
                            AutomationProperties.Name="Browse for the parent project folder" />
                </Grid>
                <ComboBox Header="Audio standard" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Mono · 48 kHz · −16 LUFS · −1 dBTP" />
                </ComboBox>
                <TextBlock Text="No provider key is needed until you audition a voice."
                           Style="{StaticResource UtilityLabelTextStyle}" />
            </StackPanel>
        </ContentDialog>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ProjectsWidthStates">
                <VisualState x:Name="NarrowProjects" />
                <VisualState x:Name="MediumProjects">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProjectHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="ProjectHeaderActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideProjects">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProjectsRoot.Margin" Value="32,28,32,48" />
                        <Setter Target="ProjectHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="ProjectHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="ProjectHeaderActions.Margin" Value="16,0,0,0" />
                        <Setter Target="ProjectHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="ProjectHeaderActions.HorizontalAlignment" Value="Right" />
                        <Setter Target="RecentProjectColumn.Width" Value="3*" />
                        <Setter Target="EmptyProjectColumn.Width" Value="2*" />
                        <Setter Target="EmptyProjectCard.(Grid.Row)" Value="0" />
                        <Setter Target="EmptyProjectCard.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
