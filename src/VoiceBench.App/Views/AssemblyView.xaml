<UserControl
    x:Class="IssueLab.VoiceBench.App.Views.AssemblyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IssueLab.VoiceBench.App.Controls"
    xmlns:local="using:IssueLab.VoiceBench.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1200" d:DesignHeight="800">

    <Grid x:Name="AssemblyRoot" Background="{ThemeResource BaseBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="AssemblyHeader" Margin="20,18,20,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="ASSEMBLY  /  FINAL OUTPUT" Style="{StaticResource UtilityLabelTextStyle}" />
                <TextBlock x:Name="AssemblyTitleText" Text="Build the final narration" Style="{StaticResource StudioHeadingTextStyle}" />
                <TextBlock Text="Only approved, current takes enter chapter masters or the included-chapter compilation."
                           Style="{StaticResource ReadingTextStyle}" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="AssemblyActions" Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Re-read the project and its built masters">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenMastersFolderButton" Style="{StaticResource QuietButtonStyle}" Click="OpenMastersFolder_Click"
                        IsEnabled="False" ToolTipService.ToolTip="Open 05-masters in File Explorer"
                        AutomationProperties.Name="Open masters folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                        <TextBlock Text="Masters folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="BuildCompilationButton" Style="{StaticResource SignalButtonStyle}"
                        Click="BuildCompilation_Click" IsEnabled="False"
                        AutomationProperties.Name="Build compilation"
                        ToolTipService.ToolTip="Build one master from every included chapter">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="Build compilation" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AssemblyInfoBar" Grid.Row="1" Margin="20,0,20,12" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="InfoBarRevealButton" Content="Show in folder" Visibility="Collapsed" Click="InfoBarReveal_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid x:Name="AssemblyStats" Grid.Row="2" Margin="20,0,20,12" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource StudioPanelStyle}" Padding="14,12">
                <StackPanel Spacing="3"><TextBlock x:Name="IncludedCountText" Text="0" Style="{StaticResource StudioHeadingTextStyle}" FontSize="18" /><TextBlock Text="INCLUDED CHAPTERS" Style="{StaticResource UtilityLabelTextStyle}" /></StackPanel>
            </Border>
            <Border x:Name="ApprovedStat" Grid.Column="1" Style="{StaticResource StudioPanelStyle}" Padding="14,12">
                <StackPanel Spacing="3"><TextBlock x:Name="ApprovedCountText" Text="0 / 0" Style="{StaticResource StudioHeadingTextStyle}" FontSize="18" /><TextBlock Text="APPROVED SEGMENTS" Style="{StaticResource UtilityLabelTextStyle}" /></StackPanel>
            </Border>
            <Border x:Name="DurationStat" Grid.Column="2" Style="{StaticResource StudioPanelStyle}" Padding="14,12">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="DurationText" Text="00:00" Style="{StaticResource StudioHeadingTextStyle}" FontSize="18" />
                    <TextBlock Text="EXPECTED DURATION" Style="{StaticResource UtilityLabelTextStyle}" />
                    <TextBlock x:Name="DurationBasisText" Text="0 measured  ·  0 estimated" Style="{StaticResource UtilityLabelTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AssemblyBody" Grid.Row="3" Margin="20,0,20,18" ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MastersColumn" Width="420" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="MastersRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="CHAPTERS  ·  ORDER, INCLUSION AND BLOCKERS" Style="{StaticResource UtilityLabelTextStyle}" />
                <ListView x:Name="AssemblyChaptersList" Grid.Row="1" SelectionMode="None"
                          Background="Transparent" BorderThickness="0" AutomationProperties.Name="Chapter assembly order and blockers" />
            </Grid>

            <Border x:Name="MastersPanel" Grid.Column="1" Style="{StaticResource StudioPanelStyle}" Padding="0"
                    AutomationProperties.Name="Built masters and mix exports">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,0" Spacing="3">
                        <TextBlock Text="BUILT MASTERS" Style="{StaticResource StudioHeadingTextStyle}" />
                        <TextBlock x:Name="MastersSummaryText" Text="Nothing built yet" Style="{StaticResource UtilityLabelTextStyle}" />
                    </StackPanel>
                    <controls:AudioTransport x:Name="MasterTransport" Grid.Row="1" Margin="12,0" />
                    <TextBlock x:Name="MastersEmptyText" Grid.Row="2" Margin="16,4,16,16" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource ReadingTextStyle}" Foreground="{ThemeResource MutedTextBrush}"
                               Text="Masters you build here, and mixes you export from Audio, appear in this list with their files one click away." />
                    <ListView x:Name="MastersList" Grid.Row="2" Padding="8,0,8,8" SelectionMode="Single"
                              SelectionChanged="MastersList_SelectionChanged"
                              AutomationProperties.Name="Built masters, newest first">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:MasterListItem">
                                <Border Style="{StaticResource StudioCardStyle}" Padding="10,8" AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Show in folder" Tag="{x:Bind FullPath}" Click="RevealMaster_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open in default player" Tag="{x:Bind FullPath}" Click="OpenMaster_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy file path" Tag="{x:Bind FullPath}" Click="CopyMasterPath_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="8" RowSpacing="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{ThemeResource ActiveSignalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Detail}" Style="{StaticResource UtilityLabelTextStyle}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind RelativePath}" />
                                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind FullPath}" Click="RevealMaster_Click"
                                                    ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show master in folder">
                                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind FullPath}" Click="OpenMaster_Click"
                                                    ToolTipService.ToolTip="Open in the default player" AutomationProperties.Name="Open master in default player">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowAssembly">
                    <VisualState.Setters>
                        <Setter Target="AssemblyHeader.Margin" Value="12,14,12,10" />
                        <Setter Target="AssemblyInfoBar.Margin" Value="12,0,12,10" />
                        <Setter Target="AssemblyStats.Margin" Value="12,0,12,10" />
                        <Setter Target="AssemblyBody.Margin" Value="12,0,12,12" />
                        <Setter Target="ApprovedStat.(Grid.Row)" Value="1" />
                        <Setter Target="ApprovedStat.(Grid.Column)" Value="0" />
                        <Setter Target="DurationStat.(Grid.Row)" Value="2" />
                        <Setter Target="DurationStat.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideAssembly">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AssemblyActions.(Grid.Row)" Value="0" />
                        <Setter Target="AssemblyActions.(Grid.Column)" Value="1" />
                        <Setter Target="AssemblyActions.Margin" Value="16,0,0,0" />
                        <Setter Target="ApprovedStat.(Grid.Row)" Value="0" />
                        <Setter Target="ApprovedStat.(Grid.Column)" Value="1" />
                        <Setter Target="DurationStat.(Grid.Row)" Value="0" />
                        <Setter Target="DurationStat.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
