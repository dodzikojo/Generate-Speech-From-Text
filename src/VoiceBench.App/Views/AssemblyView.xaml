<UserControl
    x:Class="IssueLab.VoiceBench.App.Views.AssemblyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1200" d:DesignHeight="800">

    <Grid x:Name="AssemblyRoot" Background="{ThemeResource BaseBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="AssemblyHeader" Margin="20,18,20,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="ASSEMBLY  /  FINAL OUTPUT" Style="{StaticResource UtilityLabelTextStyle}" />
                <TextBlock x:Name="AssemblyTitleText" Text="Build the final narration" Style="{StaticResource StudioHeadingTextStyle}" />
                <TextBlock Text="Only approved, current takes enter chapter masters or the included-chapter compilation."
                           Style="{StaticResource ReadingTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="AssemblyActions" Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" />
                <Button x:Name="BuildCompilationButton" Content="Build compilation" Style="{StaticResource SignalButtonStyle}"
                        Click="BuildCompilation_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AssemblyInfoBar" Grid.Row="1" Margin="20,0,20,12" IsOpen="False" IsClosable="True" />

        <Grid x:Name="AssemblyStats" Grid.Row="2" Margin="20,0,20,12" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource StudioPanelStyle}">
                <StackPanel Spacing="3"><TextBlock x:Name="IncludedCountText" Text="0" Style="{StaticResource StudioHeadingTextStyle}" /><TextBlock Text="INCLUDED CHAPTERS" Style="{StaticResource UtilityLabelTextStyle}" /></StackPanel>
            </Border>
            <Border x:Name="ApprovedStat" Grid.Column="1" Style="{StaticResource StudioPanelStyle}">
                <StackPanel Spacing="3"><TextBlock x:Name="ApprovedCountText" Text="0 / 0" Style="{StaticResource StudioHeadingTextStyle}" /><TextBlock Text="APPROVED SEGMENTS" Style="{StaticResource UtilityLabelTextStyle}" /></StackPanel>
            </Border>
            <Border x:Name="DurationStat" Grid.Column="2" Style="{StaticResource StudioPanelStyle}">
                <StackPanel Spacing="3"><TextBlock x:Name="DurationText" Text="00:00" Style="{StaticResource StudioHeadingTextStyle}" /><TextBlock Text="ESTIMATED DURATION" Style="{StaticResource UtilityLabelTextStyle}" /></StackPanel>
            </Border>
        </Grid>

        <ListView x:Name="AssemblyChaptersList" Grid.Row="3" Margin="20,0,20,18" SelectionMode="None"
                  Background="Transparent" BorderThickness="0" AutomationProperties.Name="Chapter assembly order and blockers" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowAssembly">
                    <VisualState.Setters>
                        <Setter Target="AssemblyHeader.Margin" Value="12,14,12,10" />
                        <Setter Target="AssemblyInfoBar.Margin" Value="12,0,12,10" />
                        <Setter Target="AssemblyStats.Margin" Value="12,0,12,10" />
                        <Setter Target="ApprovedStat.(Grid.Row)" Value="1" />
                        <Setter Target="ApprovedStat.(Grid.Column)" Value="0" />
                        <Setter Target="DurationStat.(Grid.Row)" Value="2" />
                        <Setter Target="DurationStat.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideAssembly">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AssemblyActions.(Grid.Row)" Value="0" />
                        <Setter Target="AssemblyActions.(Grid.Column)" Value="1" />
                        <Setter Target="AssemblyActions.Margin" Value="16,0,0,0" />
                        <Setter Target="ApprovedStat.(Grid.Row)" Value="0" />
                        <Setter Target="ApprovedStat.(Grid.Column)" Value="1" />
                        <Setter Target="DurationStat.(Grid.Row)" Value="0" />
                        <Setter Target="DurationStat.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
