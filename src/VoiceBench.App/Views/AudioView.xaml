<UserControl x:Class="IssueLab.VoiceBench.App.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IssueLab.VoiceBench.App.Controls">
    <Grid Margin="16,14,16,12" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="AUDIO  /  ARRANGEMENT" Style="{StaticResource UtilityLabelTextStyle}"/>
                <TextBlock Text="Shape the mix" Style="{StaticResource StudioHeadingTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource QuietButtonStyle}" Click="OpenFolder_Click" Tag="GeneratedAudio"
                        ToolTipService.ToolTip="Open 04-generated-audio: every take and imported recording"
                        AutomationProperties.Name="Open generated audio folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                        <TextBlock Text="Generated audio"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButtonStyle}" Click="OpenFolder_Click" Tag="Masters"
                        ToolTipService.ToolTip="Open 05-masters: exported mixes and narration masters"
                        AutomationProperties.Name="Open masters folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="13"/>
                        <TextBlock Text="Masters folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="AudioInfoBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="520"
                 Canvas.ZIndex="5" IsOpen="False" IsClosable="True" Severity="Error"/>
        <controls:AudioTimelineControl x:Name="Timeline" Grid.Row="1"/>
    </Grid>
</UserControl>
