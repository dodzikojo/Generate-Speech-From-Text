<UserControl x:Class="IssueLab.VoiceBench.App.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IssueLab.VoiceBench.App.Controls">
    <Grid Margin="16,18,16,12" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="3"><TextBlock Text="AUDIO  /  ARRANGEMENT" Style="{StaticResource UtilityLabelTextStyle}"/><TextBlock Text="Shape the mix" Style="{StaticResource StudioHeadingTextStyle}"/></StackPanel>
        <controls:AudioTimelineControl x:Name="Timeline" Grid.Row="1"/>
    </Grid>
</UserControl>
