<UserControl
    x:Class="IssueLab.VoiceBench.App.Controls.AudioTransport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="TransportSurface"
            Background="{ThemeResource PanelRaisedBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10"
            AutomationProperties.Name="Audio playback transport">
        <Grid x:Name="TransportHeader" ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TransportTimeColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Content="▶  Play"
                    MinWidth="78"
                    Style="{StaticResource SignalButtonStyle}"
                    Click="PlayPause_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Play audio"
                    AutomationProperties.HelpText="Play or pause the loaded narration take" />
            <Button x:Name="RestartButton"
                    Grid.Column="1"
                    Content="↺"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="Restart_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Restart audio from the beginning"
                    ToolTipService.ToolTip="Restart" />

            <StackPanel x:Name="TransportMetadata" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,2,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="AudioLabelText"
                           Text="NO AUDIO LOADED"
                           Style="{StaticResource UtilityLabelTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PlaybackStateText"
                           Text="Render or select a take to listen"
                           FontFamily="{StaticResource ReadingFont}"
                           FontSize="12"
                           Foreground="{ThemeResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="TransportTime" Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentTimeText"
                           Text="00:00"
                           Style="{StaticResource UtilityLabelTextStyle}" />
                <TextBlock Text="/" Style="{StaticResource UtilityLabelTextStyle}" />
                <TextBlock x:Name="DurationText"
                           Text="00:00"
                           Style="{StaticResource UtilityLabelTextStyle}" />
            </StackPanel>

            <Slider x:Name="PositionSlider"
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    StepFrequency="0.25"
                    IsEnabled="False"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource ActiveSignalBrush}"
                    ValueChanged="PositionSlider_ValueChanged"
                    AutomationProperties.Name="Playback position"
                    AutomationProperties.HelpText="Seek through the loaded narration take" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="TransportWidthStates">
                    <VisualState x:Name="NarrowTransport" />
                    <VisualState x:Name="WideTransport">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="620" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TransportTimeColumn.Width" Value="Auto" />
                            <Setter Target="TransportMetadata.(Grid.Row)" Value="0" />
                            <Setter Target="TransportMetadata.(Grid.Column)" Value="2" />
                            <Setter Target="TransportMetadata.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="TransportMetadata.Margin" Value="0" />
                            <Setter Target="TransportTime.(Grid.Column)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Border>
</UserControl>
