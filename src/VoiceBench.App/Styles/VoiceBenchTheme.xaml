<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BaseBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="PanelBrush" Color="#16181D" />
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1B1E24" />
            <SolidColorBrush x:Key="DividerBrush" Color="#23262E" />
            <SolidColorBrush x:Key="ReadingTextBrush" Color="#EDEFF3" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#969BA7" />
            <SolidColorBrush x:Key="ActiveSignalBrush" Color="#35C7E8" />
            <SolidColorBrush x:Key="PickupBrush" Color="#F49B52" />
            <SolidColorBrush x:Key="ApprovalBrush" Color="#58C58B" />
            <SolidColorBrush x:Key="FailureBrush" Color="#EF6A6A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BaseBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="PanelBrush" Color="#16181D" />
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1B1E24" />
            <SolidColorBrush x:Key="DividerBrush" Color="#23262E" />
            <SolidColorBrush x:Key="ReadingTextBrush" Color="#EDEFF3" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#969BA7" />
            <SolidColorBrush x:Key="ActiveSignalBrush" Color="#35C7E8" />
            <SolidColorBrush x:Key="PickupBrush" Color="#F49B52" />
            <SolidColorBrush x:Key="ApprovalBrush" Color="#58C58B" />
            <SolidColorBrush x:Key="FailureBrush" Color="#EF6A6A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ReadingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ActiveSignalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PickupBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ApprovalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FailureBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="ReadingFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="UtilityFont">Cascadia Mono</FontFamily>

    <Thickness x:Key="StudioPanelPadding">16</Thickness>
    <CornerRadius x:Key="StudioCornerRadius">4</CornerRadius>

    <Style x:Key="StudioHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource ReadingTextBrush}" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource ReadingTextBrush}" />
    </Style>

    <Style x:Key="UtilityLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UtilityFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
    </Style>

    <Style x:Key="ReadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ReadingFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource ReadingTextBrush}" />
    </Style>

    <Style x:Key="StudioPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StudioCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource StudioPanelPadding}" />
    </Style>

    <Style x:Key="SignalButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource ActiveSignalBrush}" />
        <Setter Property="Foreground" Value="#081014" />
        <Setter Property="CornerRadius" Value="{StaticResource StudioCornerRadius}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ActiveSignalBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ReadingTextBrush}" />
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ReadingFont}" />
        <Setter Property="Background" Value="{ThemeResource PanelRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ReadingTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StudioCornerRadius}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ActiveSignalBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ReadingTextBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ReadingFont}" />
        <Setter Property="Foreground" Value="{ThemeResource ReadingTextBrush}" />
        <Setter Property="Background" Value="{ThemeResource BaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource StudioCornerRadius}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ActiveSignalBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource ReadingFont}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ActiveSignalBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ReadingTextBrush}" />
    </Style>
</ResourceDictionary>
